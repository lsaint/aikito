#!/usr/bin/env python3
import sys
import warnings
from pathlib import Path

warnings.warn(
    "Invoking via bin/aikito is deprecated and will be removed in v1.30.0. "
    "Use 'python -m aikito' or install via pip/uv.",
    DeprecationWarning,
    stacklevel=1,
)

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from aikito.cli import main

if __name__ == "__main__":
    main()
